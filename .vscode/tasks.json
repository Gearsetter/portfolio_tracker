{
  // Terminal > Run Task ...   (Ctrl/Cmd+Shift+B runs the first, Test task = "Tests: all")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "App: run (Streamlit)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "streamlit", "run", "app.py", "--server.port", "8501"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Tests: all",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Tests: fast (without the browser test)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-m", "not gui"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Sample workbook: rebuild (offline)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/make_sample_workbook.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
