// Dev container for the IBKR Portfolio Tracker.
// Needs Docker (Docker Desktop, Docker Engine, ...) and the VS Code "Dev Containers" extension:
// open this folder in VS Code and run  "Dev Containers: Reopen in Container".   Reference: https://containers.dev/implementors/json_reference/
{
  "name": "IBKR Portfolio Tracker",

  // Ubuntu 24.04 + Python 3.12 + LibreOffice Calc, packages in /opt/venv (see Dockerfile)
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      // LibreOffice Calc (about 0.5 GB): stores calculated values in the workbook, enables the tests that recalculate it
      "INSTALL_LIBREOFFICE": "true",
      // Chromium (about 0.7 GB) for the real-browser smoke test: set to "true", then "Dev Containers: Rebuild Container"
      "INSTALL_PLAYWRIGHT": "false"
    }
  },

  "remoteUser": "vscode",

  // The app listens on 127.0.0.1 inside the container (.streamlit/config.toml). VS Code tunnels the port to your
  // computer, so it is reachable at http://localhost:8501 on this machine only - nothing is published on the network.
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "IBKR Portfolio Tracker", "onAutoForward": "notify" }
  },

  // once, after the container has been created
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "mechatroner.rainbow-csv",
        "GrapeCity.gc-excelviewer"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["tests"],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
