# IBKR Portfolio Tracker - settings for "docker compose" (README, section 11.2).
#
# Every setting is optional. To change one: copy this file to ".env" (next to docker-compose.yml), remove the "#" in
# front of the line and edit the value. Then start again:  docker compose up -d --build
# The values below are the defaults.

# Time zone of the container. The app stamps its workbooks and the "last refresh" with the local time, and the
# container clock is UTC unless you say otherwise. Use a name of the tz database: Europe/Budapest, America/New_York ...
#TZ=UTC

# Port of this computer on which the app opens: http://localhost:8501
# Change it when 8501 is taken - for example while the VS Code dev container is running.
#IBKR_TRACKER_PORT=8501

# Address the port is published on. 127.0.0.1 = this computer only (recommended: the app has no login and shows your
# whole portfolio). Anything else - 0.0.0.0 for example - makes the app reachable from the network.
#IBKR_TRACKER_BIND=127.0.0.1

# ---- build options (take effect with: docker compose up --build) ----
# LibreOffice Calc lets the app store the calculated values inside the workbook. "false" makes the image about 0.5 GB
# smaller; Excel then calculates the workbook when you open it.
#INSTALL_LIBREOFFICE=true

# User/group id of the app user in the image. You rarely need this: at start the container adapts itself to the owner
# of the ./data folder.
#APP_UID=1000
#APP_GID=1000
